# CREDShield Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Midnight Network
NEXT_PUBLIC_NETWORK_ID=undeployed
NEXT_PUBLIC_INDEXER_URL=http://localhost:8088/api/v3/graphql
NEXT_PUBLIC_PROOF_SERVER_URL=http://localhost:6300
NEXT_PUBLIC_NODE_URL=http://localhost:9944

# For preprod testnet:
# NEXT_PUBLIC_NETWORK_ID=preprod
# NEXT_PUBLIC_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
# NEXT_PUBLIC_PROOF_SERVER_URL=http://localhost:6300
# NEXT_PUBLIC_NODE_URL=https://rpc.preprod.midnight.network

# Contract address (set after deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# App
NEXT_PUBLIC_APP_NAME=CREDShield
NEXT_PUBLIC_APP_URL=http://localhost:3000
