{
  "name": "@credshield/contract",
  "version": "1.0.0",
  "description": "CREDShield Compact smart contract for confidential credential verification",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "compact": "compact compile src/credshield.compact src/managed/credshield",
    "build": "npm run compact && tsc --build",
    "build:ts": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:compile": "npm run compact && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
